# Government Order Publishing Platform Environment Config
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/govt_order_portal?retryWrites=true&w=majority
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=supersecret_jwt_key_govt_order_platform_2026_secure
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (bootstraps on first run if database is empty)
ADMIN_INITIAL_EMAIL=admin@rajpatra.gov.in
ADMIN_INITIAL_PASSWORD=Admin@12345
ADMIN_INITIAL_NAME=System Administrator

# Google Gemini AI Summary (Optional: for citizen plain-language 3-bullet summaries)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary Storage for Gazette PDFs (Optional: if empty, local disk storage is used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
